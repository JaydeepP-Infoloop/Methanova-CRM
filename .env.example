NODE_ENV=development
API_PORT=4000
JWT_SECRET=change-me-in-development
# Access token lifetime (jsonwebtoken "expiresIn" format) and refresh token lifetime in ms.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_MS=604800000
MONGODB_URI=mongodb://127.0.0.1:27017/methanova_crm?replicaSet=rs0&directConnection=true
WEB_ORIGIN=http://localhost:5173
# Optional. If SEED_ADMIN_PASSWORD is left blank, the seed script generates a
# random dev-only password and prints it once to the console — it is never
# hardcoded in source. Set both here only for a stable local login.
SEED_ADMIN_EMAIL=admin@methanova.local
SEED_ADMIN_PASSWORD=
